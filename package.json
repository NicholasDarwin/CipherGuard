{
  "name": "cipherguard",
  "version": "3.0.0",
  "private": true,
  "description": "Security scanner for public GitHub repositories: secrets, risky code, and vulnerable dependencies, enriched with OSINT data.",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "lint": "npm run lint -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}

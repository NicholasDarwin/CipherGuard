# CipherGuard configuration. Every key is optional; without one, the scanner
# skips or limits the matching data source and says so in the report.
# Copy to .env for local development; set the same names in Vercel or in the
# cipherguard-secrets Kubernetes Secret for deployments.

# --- AI analysis (https://aistudio.google.com/app/apikey) -------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- OSINT enrichment -------------------------------------------------------
# Raises GitHub limits (advisories, repo metadata) from 60 to 5000 requests/hour.
# A fine-grained token with no permissions is enough for public data.
GITHUB_TOKEN=
# Raises NVD limits from 5 to 50 requests per 30 seconds.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Kubernetes worker only -------------------------------------------------
# Adds a Snyk dependency scan alongside OSV.
SNYK_TOKEN=

# --- Shared report links ----------------------------------------------------
# Upstash Redis REST credentials (Vercel KV / Upstash integration sets these).
# Without them, share links embed a redacted copy of the report in the URL.
KV_REST_API_URL=
KV_REST_API_TOKEN=
SHARE_TTL_DAYS=30

# --- Limits -----------------------------------------------------------------
# Total time for one scan. Keep under the platform's function limit (60 s on
# Vercel Hobby without Fluid compute).
SCAN_BUDGET_MS=55000
ENRICH_BUDGET_MS=20000
MAX_REPO_MB=100

# --- API server / Kubernetes ------------------------------------------------
PORT=4000
WORKER_IMAGE=cipherguard/scanner-worker:latest
API_CALLBACK_URL=http://localhost:4000
JOB_NAMESPACE=default
# Set to "cluster" to use the Kubernetes POST/poll flow without a cluster
# (scans still run in-process). Useful for developing the cluster UI.
SCAN_MODE=
# Comma-separated origins allowed to call the API (default: any).
CORS_ORIGIN=

# ---- CipherGuard scanner worker (one Kubernetes Job per scan) ----
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

# Snyk CLI is optional at runtime; it only runs when SNYK_TOKEN is set.
RUN npm install -g snyk@1 && npm cache clean --force

COPY package.json package-lock.json ./
COPY backend/package.json backend/
RUN npm ci --omit=dev -w backend --include-workspace-root=false

COPY backend/ backend/

USER node
CMD ["node", "backend/scanner-worker.js"]
